# Copy to .env and fill in. Never commit .env.

# --- Generation LLM (answers) ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# --- Judge LLM (answer-quality eval; different model family than generator) ---
JUDGE_PROVIDER=mistral
JUDGE_MODEL=mistral-medium-2604
JUDGE_API_KEY=

# --- Embeddings (local, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store (local pgvector container from docker-compose.yml) ---
DATABASE_URL=postgresql://rag:rag@localhost:5544/rag

# --- Chunking / retrieval defaults ---
CHUNK_SIZE=256
CHUNK_OVERLAP=32
TOP_K=5
MIN_SCORE=0.5
