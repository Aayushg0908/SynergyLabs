# Copy to .env and fill in the keys. Never commit .env.
# Judge and generator are configured independently; each names a provider whose key is used.

# --- Provider keys ---
NVIDIA_API_KEY=
GROQ_API_KEY=
# optional, for a third judge family / ensemble
GEMINI_API_KEY=

# --- Generator (produces model_output for suites that need generation; prompt v1 vs v2 A/B) ---
GENERATOR_PROVIDER=groq
GENERATOR_MODEL=openai/gpt-oss-120b

# --- Primary judge (different model family from the generator) ---
JUDGE_PROVIDER=nvidia
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JUDGE_TEMPERATURE=0.0

# --- Secondary judge (cross-family agreement / ensemble) ---
JUDGE2_PROVIDER=groq
JUDGE2_MODEL=qwen/qwen3.8-27b
